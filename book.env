# The book wikikit's OWN tests build: a fixture with nothing of any real book's
# (tests/fixture_book.py), so the engine's suite can only pass on the engine.
# A real book's repository names itself here instead, and keeps its database
# URL in its private .env.
WIKIKIT_CORPUS=fixture_book:BARE
# The engine's tests seed their own SQLite databases; this URL is never
# connected to, but the engine requires one to be named.
WIKIKIT_DATABASE_URL=sqlite://
